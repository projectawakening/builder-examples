{
  "name": "contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "mud build",
    "clean": "forge clean && shx rm -rf src/**/codegen",
    "deploy:local": ". ./.env && pnpm run build && mud deploy --profile=local --worldAddress ${WORLD_ADDRESS:-$1}",
    "deploy:garnet": ". ./.env && pnpm run build && mud deploy --profile=garnet --worldAddress ${WORLD_ADDRESS:-$1}",
    "deploy:redstone": ". ./.env && pnpm run build && mud deploy --profile=redstone --worldAddress ${WORLD_ADDRESS:-$1}",
    "dev": "mud dev-contracts",
    "lint": "pnpm run prettier && pnpm run solhint",
    "prettier": "prettier --write 'src/**/*.sol'",
    "solhint": "solhint --config ./.solhint.json 'src/**/*.sol' --fix",
    "test:deploy": "mud test",
    "test": ". ./.env && forge test --fork-url $RPC_URL",
    "mock-gates": ". ./.env && pnpm forge script ./script/MockGates.s.sol:MockGates --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address)\" $WORLD_ADDRESS -vvv",
    "configure-gates": ". ./.env && pnpm forge script ./script/ConfigureGates.s.sol:ConfigureGates --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address)\" $WORLD_ADDRESS -vvv",
    "random-address": ". ./.env && pnpm forge script ./script/RandomAddress.s.sol:RandomAddress --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run()\"",
    "custom": ". ./.env && pnpm forge script ./script/CustomScript.s.sol:CustomScript --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address)\" $WORLD_ADDRESS -vvv",
    "link-gates": ". ./.env && pnpm forge script ./script/LinkGates.s.sol:LinkGates --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address)\" $WORLD_ADDRESS -vvv",
    "jump": ". ./.env && pnpm forge script ./script/Jump.s.sol:Jump --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,uint256)\" $WORLD_ADDRESS",
    "add-access-list-manager": ". ./.env && pnpm forge script ./script/AddAccessListManager.s.sol:AddAccessListManager --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,address)\" $WORLD_ADDRESS",
    "add-player-to-access-list": ". ./.env && pnpm forge script ./script/AddPlayerToAccessList.s.sol:AddPlayerToAccessList --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,uint256,bytes32)\" $WORLD_ADDRESS",
    "add-corp-to-access-list": ". ./.env && pnpm forge script ./script/AddCorpToAccessList.s.sol:AddCorpToAccessList --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,uint256,bytes32)\" $WORLD_ADDRESS",
    "remove-player-from-access-list": ". ./.env && pnpm forge script ./script/RemovePlayerFromAccessList.s.sol:RemovePlayerFromAccessList --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,uint256,bytes32)\" $WORLD_ADDRESS",
    "remove-corp-from-access-list": ". ./.env && pnpm forge script ./script/RemoveCorpFromAccessList.s.sol:RemoveCorpFromAccessList --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,uint256,bytes32)\" $WORLD_ADDRESS",
    "add-access-list-to-gate": ". ./.env && pnpm forge script ./script/AddAccessListToGate.s.sol:AddAccessListToGate --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,uint256,bytes32)\" $WORLD_ADDRESS",
    "remove-access-list-From-gate": ". ./.env && pnpm forge script ./script/RemoveAccessListFromGate.s.sol:RemoveAccessListFromGate --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,uint256,bytes32)\" $WORLD_ADDRESS",
    "address-of-key": ". ./.env && pnpm forge script ./script/AddressOfKey.s.sol:AddressOfKey --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(uint256)\"",
    "create-whitelist": ". ./.env && pnpm forge script ./script/CreateWhitelist.s.sol:CreateWhitelist --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,string)\" $WORLD_ADDRESS",
    "create-blacklist": ". ./.env && pnpm forge script ./script/CreateBlacklist.s.sol:CreateBlacklist --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(address,string)\" $WORLD_ADDRESS",    
    "delete-access-list": ". ./.env && pnpm forge script ./script/DeleteAccessList.s.sol:DeleteAccessList --broadcast --rpc-url $RPC_URL --chain-id $CHAIN_ID --sig \"run(bytes32)\" $WORLD_ADDRESS",
    "env-stillness": "bash ../../shell-scripts/ConvertEnvToServer.sh stillness",
    "env-nova": "bash ../../shell-scripts/ConvertEnvToServer.sh nova",
    "env-local": "bash ../../shell-scripts/ConvertEnvToLocal.sh",
    "set-namespace": "bash ../../shell-scripts/SetNamespace.sh"
  },
  "dependencies": {
    "@latticexyz/cli": "2.2.14",
    "@latticexyz/schema-type": "2.2.14",
    "@latticexyz/store": "2.2.14",
    "@latticexyz/store-indexer": "2.2.14",
    "@latticexyz/explorer": "2.2.14",
    "@latticexyz/world": "2.2.14",
    "@latticexyz/world-modules": "2.2.14",
    "@eveworld/common-constants": "0.0.13",
    "@eveworld/world": "0.0.17"
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "ds-test": "https://github.com/dapphub/ds-test.git#e282159d5170298eb2455a6c05280ab5a73a4ef0",
    "forge-std": "https://github.com/foundry-rs/forge-std.git#74cfb77e308dd188d2f58864aaf44963ae6b88b1",
    "prettier": "3.2.5",
    "prettier-plugin-solidity": "1.3.1",
    "solhint": "^3.3.7",
    "solhint-config-mud": "2.2.9",
    "solhint-plugin-mud": "2.2.9"
  }
}